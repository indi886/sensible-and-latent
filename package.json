{
  "name": "sensible-and-latent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sensible & Latent — heating, cooling & air. One refrigeration cycle, seen through a thermal imager.",
  "scripts": {
    "dev": "vite --port 5211 --strictPort --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4211 --strictPort --host 127.0.0.1",
    "start": "npm install && npm run build && npm run preview",
    "media": "node scripts/media.mjs",
    "reel": "bash scripts/cut-reel.sh",
    "shoot": "node scripts/shoot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.55.1",
    "puppeteer-core": "^24.43.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
